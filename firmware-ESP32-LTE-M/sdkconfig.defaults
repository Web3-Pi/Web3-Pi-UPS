# Defaults for the W3P MODEM V1 M.2 card (ESP32-S3FH4R2: 4 MB in-package Flash,
# 2 MB PSRAM — PSRAM left disabled, firmware does not use it).
# (Was: LilyGo T-SIM7080G-S3 dev board, ESP32-S3-WROOM-1, 16 MB Flash. The M.2
#  production card has a different flash size AND a different GPIO/PMU pinout.)
# Delete sdkconfig if you want a clean rebuild from these defaults.

# --- Console (USB-Serial-JTAG over USB-C) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# --- lwIP: enable PPP so esp_modem can attach the cellular modem as a netif ---
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_PPP_PAP_SUPPORT=y
CONFIG_LWIP_PPP_CHAP_SUPPORT=y
CONFIG_LWIP_PPP_NOTIFY_PHASE_SUPPORT=y

# --- Flash size (M.2 card's ESP32-S3FH4R2 has 4 MB in-package flash) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# --- Custom partition table (Track 0 / WS-10 + OTA-1): two-OTA layout
#     (ota_0/ota_1 + otadata) for LTE OTA self-update, plus the `prov` NVS
#     partition for the per-device MQTT secret. See partitions.csv. ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# --- OTA rollback (OTA-1): a freshly OTA'd image boots as
#     ESP_OTA_IMG_PENDING_VERIFY; fw_ota.c marks it valid on the first
#     healthy uplink (hooked into modem.c's supervision loop) and rolls it
#     back after 10 min without one — so a broken-but-not-crashing image
#     recovers on its own. ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- TLS: use the mbedTLS-bundled root CA store so esp-mqtt can verify
#         broker.w3p.ovh's Let's Encrypt cert without us having to embed
#         certs ourselves. ---
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# Allocate mbedTLS handshake buffers on the heap instead of the stack.
# Without this the per-task stack must be huge to fit a TLS 1.2/1.3
# handshake, which manifests as an X509 fatal error during connect.
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# --- MISC-9: buffer uplinks across LTE/MQTT outages in the esp-mqtt RAM
#     outbox (mqtt_publish_raw enqueues with store=true when disconnected).
#     Default expiry is 30 s — far too short for a modem reattach; raise to
#     10 min. The outbox is additionally size-bounded in code (32 KB). ---
CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=3600000

# --- net.status byte counters: lwIP statistics must be on so opt.h doesn't
#     force-define MIB2_STATS 0 (the MIB2_STATS=1 itself comes from a global
#     compile option in CMakeLists.txt — it changes struct netif layout). ---
CONFIG_LWIP_STATS=y

# --- UART ISR in IRAM: without this every flash op (OTA writes, NVS commits)
#     masks the UART ISRs for the whole cache-disabled window; at 921600 the
#     128 B RX FIFO of the RP2040 link (UART2) overflows within ~1.4 ms, and
#     the resulting ring-buffer-full storms arm a cross-core race in the IDF
#     driver (uart.c uart_check_buf_full vs ISR, present through v6.0.2 and
#     master) that leaves RX interrupts permanently disabled — RX goes
#     silently deaf until reboot. Field-hit on two units, 2026-08. With this
#     set, uart_driver_install auto-adds ESP_INTR_FLAG_IRAM. ---
CONFIG_UART_ISR_IN_IRAM=y

# --- Release size optimization (2026-08-20, esp32:0.8.6) ---
# -Os instead of the IDF default -Og: image 948 -> 859 KB. Matters for OTA
# over slow Cat-M links: devices running <=0.8.4 download under a 10-min
# hard cap (FW_OTA_TIMEOUT_S was raised to 20 min only in 0.8.5), and at
# the ~14 kbps observed in the field (unit ...9940) the -Og image missed
# that window while the -Os one fits with ~1.5 min to spare.
# NB: a stale generated sdkconfig silently overrides this default — flip
# CONFIG_COMPILER_OPTIMIZATION_* there too (or delete sdkconfig to regen).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

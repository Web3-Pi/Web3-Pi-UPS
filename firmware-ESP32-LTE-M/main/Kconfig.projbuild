menu "Web3 Pi modem UART"

    choice WUPS_MODEM_UART_SPEED
        prompt "SIM7080G UART speed"
        default WUPS_MODEM_UART_115200
        help
            The firmware detects 115200/230400 before PPP, plus 921600
            for return from the previous experiment,
            then synchronizes the ESP32 UART and the modem's saved AT+IPR.
            Select 115200 to restore the modem before installing old firmware.
            The selected rate stays fixed during operation.

        config WUPS_MODEM_UART_115200
            bool "115200 bit/s (baseline / restore)"

        config WUPS_MODEM_UART_230400
            bool "230400 bit/s (research)"

    endchoice

    config WUPS_MODEM_UART_BAUD
        int
        default 230400 if WUPS_MODEM_UART_230400
        default 115200

    config WUPS_MODEM_TX_UNBUFFERED
        bool "Use unbuffered modem TX (TX0 experiment)"
        default n
        help
            Compare the SDK's FIFO-semaphore TX path with the default
            512-byte TX ring. Keep baud, RX buffers and task settings fixed.

    config WUPS_MODEM_TX_BUFFER_SIZE
        int
        default 0 if WUPS_MODEM_TX_UNBUFFERED
        default 512

    config WUPS_PERF_DIAG
        bool "Sparse CPU, memory and transport diagnostics"
        default n
        depends on FREERTOS_GENERATE_RUN_TIME_STATS
        depends on FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER
        depends on FREERTOS_RUN_TIME_COUNTER_TYPE_U64
        depends on !FREERTOS_SMP
        help
            Report 30-second per-core idle deltas and bounded UART/PPP
            aggregates. Enable only in research images; hooks never log
            payloads and leave transport return values unchanged.

    config WUPS_PERF_BENCH
        bool "One-shot synthetic HTTPS duplex benchmark"
        default n
        depends on WUPS_PERF_DIAG
        help
            After a healthy MQTT uplink and a quiet baseline, download and
            upload 512 KiB concurrently using Cloudflare speedtest endpoints.
            Uploads contain only synthetic zero bytes. Runs once per boot;
            leave disabled in images intended for normal device operation.

endmenu
